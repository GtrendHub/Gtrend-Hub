# Gtrend Tech Hub — Frontend Environment Variables (Example)
# Copy this file to .env and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Access via: import.meta.env.VITE_API_BASE_URL

# ── Backend API ───────────────────────────────────────────────────────────────
# Dev: leave empty or set to localhost — the Vite proxy handles /api/* → backend
# Prod: set to your deployed API URL (e.g. https://api.gtrend.com)
VITE_API_BASE_URL=http://localhost:3000

# ── Paystack Payment Gateway ─────────────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# ── Support ───────────────────────────────────────────────────────────────────
VITE_WHATSAPP_PHONE=2347066976885

# ── App Environment ───────────────────────────────────────────────────────────
VITE_APP_ENV=development
